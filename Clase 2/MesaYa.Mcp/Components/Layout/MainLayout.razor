@inherits LayoutComponentBase
@implements IDisposable
@inject Escenarios Escenarios
@inject NavigationManager Nav

<header class="topbar">
    <a class="brand" href="">
        <span class="brand-mark">⟁</span>
        <span>MesaYa <b>MCP Lab</b></span>
    </a>
    <nav class="tabs">
        <NavLink class="tab" href="" Match="NavLinkMatch.All">🤖 Agente</NavLink>
        <NavLink class="tab" href="secuencia">📈 Secuencia en vivo</NavLink>
        <NavLink class="tab" href="inspector">🔍 Inspector MCP</NavLink>
    </nav>
    <div class="topbar-right">
        <span class="pill-mcp" title="Endpoint del servidor MCP (Streamable HTTP)">MCP · <code>@(new Uri(Nav.BaseUri))mcp</code></span>
        <span class="pill-escenario @(Escenarios.Actual == Escenario.Normal ? "" : "activo")" title="Escenario de caos del servidor MCP">
            @(Escenarios.Actual == Escenario.Normal ? "🟢" : "🌪️") @Escenarios.Describir(Escenarios.Actual)
        </span>
    </div>
</header>

<main class="contenido">
    @Body
</main>

<div id="blazor-error-ui" role="alert">
    Se interrumpió la conexión. <a href="" class="reload">Recargar la página</a>
    <button type="button" class="dismiss" aria-label="Cerrar">×</button>
</div>

@code {
    protected override void OnInitialized() => Escenarios.Cambio += Refrescar;
    void Refrescar() => InvokeAsync(StateHasChanged);
    public void Dispose() => Escenarios.Cambio -= Refrescar;
}
