@* Marcas de un mensaje del chat: si vino precargado o si el modelo ya no lo ve literal. *@

@if (M.Precargado || Resumido)
{
    <div class="msg-etiquetas">
        @if (M.Precargado)
        {
            <span class="chip">conversación previa</span>
        }
        @if (Resumido)
        {
            <span class="chip">✂ el modelo ya no lo ve: está en el resumen</span>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public Mensaje M { get; set; } = default!;
    [Parameter] public bool Resumido { get; set; }
}
